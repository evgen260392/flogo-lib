{
  "name": "flogo-calculator",
  "type": "flogo:activity",
  "version": "0.10.0",
  "title": "Calculator Activity",
  "description": "Arithmetic operations on two values",
  "homepage": "https://github.com/evgen260392/flogo-lib/tree/master/activity/calculator",
  "settings":[
    {
      "name": "Operand B",
      "type": "any",
      "required": true,
      "description": "Second operand"
    },
    {
      "name": "operator",
      "type": "string",
      "allowed": ["Add", "Sub", "Mul", "Div"],
      "description": "Arithmetic operation"
    }
  ],
  "input": [
    {
      "name": "operandA",
      "type": "any",
      "required": true,
      "description": "First operand from the flow"
    }
  ],
  "output": [
    {
      "name": "result",
      "type": "any",
      "description": "Result of the arithmetic operation"
    }
  ]
}